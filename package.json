{
  "name": "saturn-pkm",
  "private": true,
  "type": "module",
  "description": "Serverless AI endpoint deps for Saturn PKM. The app itself (public/) is static and build-free.",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "vite public --host 127.0.0.1",
    "syntax": "node --check public/script.js && node --check api/ai.js",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit tests/api",
    "test:rules": "firebase emulators:exec --only firestore,storage \"vitest run tests/rules\"",
    "test:e2e": "playwright test",
    "check": "npm run syntax && npm run lint && npm run test:unit && npm run test:e2e",
    "check:ci": "npm run syntax && npm run lint && npm run test:unit && npm run test:rules && npm run test:e2e"
  },
  "dependencies": {
    "@upstash/redis": "^1.35.3",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.31.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.54.1",
    "eslint": "^9.31.0",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.11.2",
    "globals": "^16.3.0",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  }
}
