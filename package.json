{
  "name": "saturn-pkm",
  "private": true,
  "type": "module",
  "description": "Saturn PKM: a React app built with Vite, plus a serverless AI endpoint.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit tests/api",
    "test:rules": "firebase emulators:exec --only firestore,storage \"vitest run tests/rules\"",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test:unit && npm run test:e2e",
    "check:ci": "npm run lint && npm run test:unit && npm run test:rules && npm run test:e2e"
  },
  "dependencies": {
    "@upstash/redis": "^1.35.3",
    "firebase": "^12.19.0",
    "jose": "^5.9.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.31.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.54.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.34.2",
    "globals": "^16.3.0",
    "jsdom": "^29.1.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "@firebase/app": "0.16.2"
  }
}
